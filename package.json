{
  "name": "chess-assist",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "package": "python3 scripts/package.py",
    "test:engine": "node scripts/engine-smoke.mjs",
    "test:vision": "node scripts/vision-smoke.mjs",
    "format": "prettier --write src tests scripts fixtures *.json *.ts *.html *.md"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sharp": "0.35.5",
    "stockfish": "19.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
